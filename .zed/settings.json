{
  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": {
          "run": "onType",
          "fixKind": "safe_fix",
          "typeAware": true,
          "unusedDisableDirectives": "deny",
        },
      },
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": "./.oxfmtrc.json",
          "run": "onSave",
        },
      },
    },
  },
  "languages": {
    "Markdown": {
      "format_on_save": "off",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
    },
    "JavaScript": {
      "format_on_save": "off",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
    },
    "TypeScript": {
      "format_on_save": "off",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "...",
      ],
    },
  },
}
